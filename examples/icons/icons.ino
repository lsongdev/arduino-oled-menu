#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <OledMenu.h>

Adafruit_SSD1306 display(128, 64, &Wire, -1);

const uint8_t wifiBitmap[] PROGMEM = {
  0x00,0x00,0x07,0xe0,0x1f,0xf8,0x38,0x1c,
  0x67,0xe6,0x0f,0xf0,0x1c,0x38,0x03,0xc0,
  0x07,0xe0,0x06,0x60,0x00,0x00,0x01,0x80,
  0x01,0x80,0x00,0x00,0x00,0x00,0x00,0x00
};

const uint8_t gearBitmap[] PROGMEM = {
  0x01,0x80,0x03,0xc0,0x1b,0xd8,0x1f,0xf8,
  0x0e,0x70,0x3c,0x3c,0x38,0x1c,0x70,0x0e,
  0x70,0x0e,0x38,0x1c,0x3c,0x3c,0x0e,0x70,
  0x1f,0xf8,0x1b,0xd8,0x03,0xc0,0x01,0x80
};

const uint8_t infoBitmap[] PROGMEM = {
  0x03,0xc0,0x0f,0xf0,0x1c,0x38,0x38,0x1c,
  0x70,0x0e,0x61,0x86,0xe1,0x87,0xe0,0x07,
  0xe1,0x87,0xe1,0x87,0x61,0x86,0x70,0x0e,
  0x38,0x1c,0x1c,0x38,0x0f,0xf0,0x03,0xc0
};

oledmenu::Icon wifiIcon(wifiBitmap, 16, 16);
oledmenu::Icon gearIcon(gearBitmap, 16, 16);
oledmenu::Icon infoIcon(infoBitmap, 16, 16);

oledmenu::Item items[] = {
  {"Wi-Fi", nullptr, &wifiIcon},
  {"Settings", nullptr, &gearIcon},
  {"About", nullptr, &infoIcon},
};

oledmenu::Menu menu(items, sizeof(items) / sizeof(items[0]));

void setup()
{
  display.begin(SSD1306_SWITCHCAPVCC, 0x3c);
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
}

void loop()
{
  static uint32_t changedAt = 0;

  if (millis() - changedAt > 1000) {
    changedAt = millis();
    menu.next();
  }

  display.clearDisplay();
  menu.draw(display);
  display.display();
}
